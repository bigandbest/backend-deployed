{
  "name": "backend",
  "version": "1.0.0",
  "description": "BBM",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest --testTimeout=30000",
    "test:wallet": "jest wallet.test.js --testTimeout=30000",
    "test:watch": "jest --watch",
    "server": "nodemon server.js",
    "start": "node server.js",
    "workers": "node workers/index.js",
    "dev": "nodemon server.js",
    "build": "npm run db:compile && prisma generate",
    "seed": "node seed-database.js",
    "seed:products": "node scripts/seed-products-from-excel.js",
    "seed:products:admin": "node scripts/seed-products-admin-format.js",
    "seed:product-sections": "node scripts/seed-product-sections.js",
    "verify:product-sections": "node scripts/verify-product-sections.js",
    "start:cluster": "CLUSTER_MODE=true node server.js",
    "start:single": "CLUSTER_MODE=false node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:stop": "pm2 stop bigandbest-api",
    "pm2:restart": "pm2 restart bigandbest-api",
    "pm2:reload": "pm2 reload bigandbest-api",
    "pm2:delete": "pm2 delete bigandbest-api",
    "pm2:logs": "pm2 logs bigandbest-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "db:compile": "node scripts/compile-schema.js",
    "db:generate": "npm run db:compile && prisma generate",
    "db:migrate": "npm run db:compile && prisma migrate dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Big and Best Mart",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.50.4",
    "amqplib": "^1.0.3",
    "archiver": "^7.0.1",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "form-data": "^4.0.4",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "pdfkit": "^0.18.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controller/**/*.js",
      "services/**/*.js",
      "!**/node_modules/**"
    ]
  }
}
