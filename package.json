{
  "name": "backend",
  "version": "1.0.0",
  "description": "BBM",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run --testPathPattern='(auth|product|cart|category|search|order|inventory)\\.test\\.js'",
    "test:integration": "vitest run integration.test.js",
    "test:wallet": "vitest run wallet.test.js",
    "test:auth": "vitest run auth.test.js",
    "test:product": "vitest run product.test.js",
    "test:cart": "vitest run cart.test.js",
    "test:order": "vitest run order.test.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "server": "nodemon server.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo \"No build step required\"",
    "seed": "node seed-database.js",
    "seed:product-sections": "node scripts/seed-product-sections.js",
    "verify:product-sections": "node scripts/verify-product-sections.js",
    "start:cluster": "CLUSTER_MODE=true node server.js",
    "start:single": "CLUSTER_MODE=false node server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:stop": "pm2 stop bigandbest-api",
    "pm2:restart": "pm2 restart bigandbest-api",
    "pm2:reload": "pm2 reload bigandbest-api",
    "pm2:delete": "pm2 delete bigandbest-api",
    "pm2:logs": "pm2 logs bigandbest-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "db:compile": "node scripts/compile-schema.js",
    "db:generate": "npm run db:compile && prisma generate",
    "db:migrate": "npm run db:compile && prisma migrate dev",
    "k6:smoke": "k6 run k6-tests/smoke-test.js",
    "k6:load": "k6 run k6-tests/load-test.js",
    "k6:stress": "k6 run k6-tests/stress-test.js",
    "k6:spike": "k6 run k6-tests/spike-test.js",
    "k6:api": "k6 run k6-tests/api-endpoints-test.js",
    "k6:all": "./k6-tests/run-tests.sh all"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Amit ",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.50.4",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.6",
    "twilio": "^5.11.2",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/k6": "^1.5.0",
    "@types/node": "^25.0.8",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigandbest/backend-deployed.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/bigandbest/backend-deployed/issues"
  },
  "homepage": "https://github.com/bigandbest/backend-deployed#readme"
}
