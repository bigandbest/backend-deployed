model geocode_retry_queue {
  id             Int      @id @default(autoincrement())
  entity_type    String   @db.VarChar(30)
  // 'SELLER' | 'CUSTOMER_ADDRESS' | 'WAREHOUSE'
  entity_id      String   @db.VarChar(50)  // String to support both Int and UUID IDs
  address_string String   @db.Text
  attempts       Int      @default(0)
  resolved       Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([resolved, attempts])
  @@index([entity_type])
}
