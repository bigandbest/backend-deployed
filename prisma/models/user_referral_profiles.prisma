model user_referral_profiles {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @unique @db.Uuid
  referral_code           String    @unique @db.VarChar(20)
  referral_code_active    Boolean   @default(true)
  is_blocked              Boolean   @default(false)
  total_referrals         Int       @default(0)
  successful_referrals    Int       @default(0)
  pending_referrals       Int       @default(0)
  failed_referrals        Int       @default(0)
  total_earnings          Decimal   @default(0) @db.Decimal(14, 2)
  available_balance       Decimal   @default(0) @db.Decimal(14, 2)
  pending_balance         Decimal   @default(0) @db.Decimal(14, 2)
  withdrawn_amount        Decimal   @default(0) @db.Decimal(14, 2)
  expired_amount          Decimal   @default(0) @db.Decimal(14, 2)
  used_for_purchase       Decimal   @default(0) @db.Decimal(14, 2)
  was_referred            Boolean   @default(false)
  referred_by_user_id     String?   @db.Uuid
  referred_by_code        String?   @db.VarChar(20)
  referred_at             DateTime? @db.Timestamptz
  referral_bonus_received Boolean   @default(false)
  current_tier            String?   @db.VarChar(50)
  referral_code_created_at DateTime? @db.Timestamptz
  status                  String?   @default("ACTIVE") @db.VarChar(50)
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @updatedAt @db.Timestamptz

  // Relations
  referral_transactions_as_referrer referral_transactions[] @relation("ReferrerProfile")
  referral_rewards                  referral_rewards[]
  referral_withdrawals              referral_withdrawals[]
}
