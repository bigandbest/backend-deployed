model section_subcategory_mappings {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section_id     Int
  subcategory_id String           @db.Uuid
  display_order  Int?             @default(0)
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz
  updated_at     DateTime?        @default(now()) @db.Timestamptz

  // Relations
  product_sections product_sections @relation(fields: [section_id], references: [id])
  subcategory      subcategories    @relation(fields: [subcategory_id], references: [id])
}
