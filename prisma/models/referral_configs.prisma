model referral_configs {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_enabled                Boolean   @default(true)
  program_name              String?   @default("Refer & Earn") @db.VarChar
  referrer_reward_amount    Decimal   @default(75) @db.Decimal(14, 2)
  referee_reward_amount     Decimal   @default(75) @db.Decimal(14, 2)
  min_order_value           Decimal   @default(200) @db.Decimal(14, 2)
  reward_validity_days      Int       @default(7)
  min_withdrawal_amount     Decimal   @default(100) @db.Decimal(14, 2)
  max_withdrawals_per_month Int       @default(10)
  withdrawal_enabled        Boolean   @default(true)
  return_window_days        Int       @default(7)
  max_earning_per_user      Decimal   @default(1000) @db.Decimal(14, 2)
  tiered_rewards_enabled    Boolean   @default(false)
  tiered_rewards_config     Json?
  enable_ip_tracking        Boolean   @default(true)
  max_referrals_per_ip      Int       @default(3)
  cooldown_hours            Int       @default(24)
  applicable_first_order    Boolean?  @default(true)
  enable_device_tracking    Boolean?  @default(false)
  enable_notifications      Boolean?  @default(true)
  reminder_before_expiry    Int?      @default(3)
  updated_by                String?   @db.Uuid
  created_at                DateTime  @default(now()) @db.Timestamptz
  updated_at                DateTime  @updatedAt @db.Timestamptz
}
