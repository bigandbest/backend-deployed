model warehouses {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @unique @db.VarChar
  type                        String                        @db.VarChar
  location                    String?                       @db.VarChar
  address                     String?
  contact_person              String?                       @db.VarChar
  contact_phone               String?                       @db.VarChar
  contact_email               String?                       @db.VarChar
  is_active                   Boolean?                      @default(true)
  capacity_limit              Int?
  current_utilization         Int?                          @default(0)
  operational_hours           Json?                         @default("{}")
  facilities                  Json?                         @default("{}")
  created_at                  DateTime?                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamptz(6)
  created_by                  Int?
  parent_warehouse_id         Int?
  hierarchy_level             Int?                          @default(0)

  // Relations — matching backup schema exactly
  inventory                   inventory[]
  order_items                 order_items[]
  product_warehouse_stock     product_warehouse_stock[]
  scheduled_order_slots       scheduled_order_slots[]
  scheduled_orders            scheduled_orders[]
  seller_products             seller_products[]
  stock_movements             stock_movements[]
  warehouse_pincodes          warehouse_pincodes[]
  warehouse_riders            warehouse_riders[]
  warehouse_scheduling_config warehouse_scheduling_config[]
  warehouse_sellers           warehouse_sellers[]
  warehouse_zones             warehouse_zones[]
  parent_warehouse            warehouses?                   @relation("warehouse_hierarchy", fields: [parent_warehouse_id], references: [id])
  child_warehouses            warehouses[]                  @relation("warehouse_hierarchy")
  sub_orders                  sub_orders[]
}
