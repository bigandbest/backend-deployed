enum RiderVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTION_REQUIRED
  SUSPENDED
}

model riders {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                   @unique @db.Uuid
  
  // Personal details
  vehicle_type          String?                  @db.VarChar // "bike", "scooter", "bicycle", "van"
  vehicle_number        String?                  @db.VarChar
  license_number        String?                  @db.VarChar
  emergency_contact     String?                  @db.VarChar
  
  // Verification & Status
  verification_status   RiderVerificationStatus  @default(PENDING_VERIFICATION)
  is_active             Boolean                  @default(true)
  is_verified           Boolean                  @default(false)
  is_available          Boolean                  @default(true)
  
  // Active shift tracking (guards against double check-in)
  current_shift_id      String?                  @unique @db.Uuid
  
  approved_at           DateTime?                @db.Timestamptz
  approved_by           String?                  @db.Uuid

  created_at            DateTime                 @default(now()) @db.Timestamptz
  updated_at            DateTime                 @default(now()) @db.Timestamptz

  // Relations
  users                 users                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  warehouse_riders      warehouse_riders[]
  rider_documents       rider_documents[]
  attendance_logs       attendance_logs[]
  rider_wage_logs       rider_wage_logs[]
  rider_assignments     rider_assignments[]

  @@index([user_id])
  @@index([is_available])
  @@index([verification_status])
}
