enum SellerVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTION_REQUIRED
  SUSPENDED
}

model sellers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @unique @db.Uuid
  business_name     String?   @db.VarChar
  business_type     String?   @db.VarChar
  seller_type       String    @default("SELLER") @db.VarChar

  // Business details
  gstin             String?   @db.VarChar
  pan               String?   @db.VarChar
  bank_account_no   String?   @db.VarChar
  bank_ifsc         String?   @db.VarChar
  bank_name         String?   @db.VarChar

  // Address
  address           String?
  city              String?   @db.VarChar
  state             String?   @db.VarChar
  pincode           String?   @db.VarChar

  // Location (geocoded from address)
  latitude              Decimal?  @db.Decimal(10, 7)
  longitude             Decimal?  @db.Decimal(10, 7)
  geocode_source        String?   @db.VarChar(20)
  geocode_status        String?   @default("PENDING") @db.VarChar(20)
  geocoded_at           DateTime? @db.Timestamptz
  geocoded_display_name String?   @db.Text

  // Status
  is_active         Boolean   @default(true)
  is_verified       Boolean   @default(false)
  is_open           Boolean   @default(true)
  verification_status SellerVerificationStatus @default(PENDING_VERIFICATION)
  approved_at       DateTime? @db.Timestamptz
  approved_by       String?   @db.Uuid

  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz

  // Relations
  seller_documents        seller_documents[]
  seller_negotiations     seller_negotiations[]
  seller_pincode_requests seller_pincode_requests[]
  seller_products         seller_products[]
  users                   users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  warehouse_sellers       warehouse_sellers[]

  @@index([user_id])
  @@index([seller_type])
  @@index([verification_status])
}
