model store_section_mappings {
  id           Int       @id @default(autoincrement())
  store_id     String?   @db.Uuid
  section_id   Int?
  product_id   String?   @db.Uuid
  mapping_type String?   @db.VarChar
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp

  // Relations
  recommended_store recommended_store? @relation(fields: [store_id], references: [id])
  product_sections  product_sections?  @relation(fields: [section_id], references: [id])
  products          products?          @relation(fields: [product_id], references: [id])
}
