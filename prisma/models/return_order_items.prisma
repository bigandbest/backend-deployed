model return_order_items {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_order_id String      @db.Uuid
  order_item_id   String      @db.Uuid
  quantity        Int         @default(1)
  return_reason   String?
  created_at      DateTime?   @default(now()) @db.Timestamp

  // Relations
  return_order    return_orders @relation(fields: [return_order_id], references: [id], onDelete: Cascade)
  order_item      order_items   @relation(fields: [order_item_id], references: [id])

  @@index([return_order_id])
  @@index([order_item_id])
}
