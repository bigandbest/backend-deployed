model payout_disputes {
  id              Int       @id @default(autoincrement())
  payout_id       Int
  rider_id        String    @db.Uuid                // denormalised for fast lookup
  reason          String    @db.VarChar(50)
  // WRONG_DISTANCE | WRONG_AMOUNT | NOT_RECEIVED | OTHER
  note            String?   @db.Text
  status          String    @default("OPEN") @db.VarChar(20)
  // OPEN | RESOLVED
  resolution_note String?   @db.Text
  raised_at       DateTime  @default(now()) @db.Timestamptz
  resolved_at     DateTime? @db.Timestamptz

  payout          rider_payouts @relation(fields: [payout_id], references: [id])

  @@index([payout_id])
  @@index([rider_id])
  @@index([status])
}
