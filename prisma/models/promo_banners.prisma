model promo_banners {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar
  subtitle      String?   @db.VarChar
  discount      String?   @db.VarChar
  description   String?   @db.VarChar
  button_text   String?   @default("SHOP NOW") @db.VarChar
  bg_color      String?   @default("from-indigo-600 via-purple-600 to-pink-600") @db.VarChar
  accent_color  String?   @default("from-pink-400 to-rose-400") @db.VarChar
  icon          String?   @default("💪") @db.VarChar
  category      String?   @db.VarChar
  link          String?   @db.VarChar
  active        Boolean?  @default(true)
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp
  updated_at    DateTime? @default(now()) @db.Timestamp
}
