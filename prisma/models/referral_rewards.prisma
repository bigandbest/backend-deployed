model referral_rewards {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String    @db.Uuid
  user_profile_id           String    @db.Uuid
  referral_transaction_id   String?   @db.Uuid
  amount                    Decimal   @db.Decimal(10, 2)
  original_amount           Decimal   @db.Decimal(10, 2)
  remaining_amount          Decimal   @db.Decimal(10, 2)
  used_amount               Decimal   @default(0) @db.Decimal(10, 2)
  reward_type               String    @db.VarChar(50)
  source_type               String?   @db.VarChar(50)
  source_description        String?   @db.VarChar
  status                    String    @default("ACTIVE") @db.VarChar(50)
  credited_at               DateTime  @default(now()) @db.Timestamptz
  expires_at                DateTime? @db.Timestamptz
  expired_at                DateTime? @db.Timestamptz
  expiry_reminder_sent      Boolean   @default(false)
  expiry_reminder_sent_at   DateTime? @db.Timestamptz
  urgent_reminder_sent      Boolean   @default(false)
  urgent_reminder_sent_at   DateTime? @db.Timestamptz
  created_at                DateTime  @default(now()) @db.Timestamptz
  updated_at                DateTime  @updatedAt @db.Timestamptz

  // Relations
  profile                user_referral_profiles @relation(fields: [user_profile_id], references: [id])
  referral_reward_usages referral_reward_usages[]
}
