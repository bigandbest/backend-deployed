model return_orders {
  id                                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                            String               @db.Uuid
  user_id                             String               @db.Uuid
  return_type                         String               @db.VarChar
  reason                              String
  additional_details                  String?
  bank_account_holder_name            String?              @db.VarChar
  bank_account_number                 String?              @db.VarChar
  bank_ifsc_code                      String?              @db.VarChar
  bank_name                           String?              @db.VarChar
  refund_amount                       Decimal              @db.Decimal
  refund_mode                         String?              @default("bank_transfer") @db.VarChar
  status                              String?              @default("pending") @db.VarChar
  admin_notes                         String?
  admin_id                            String?              @db.Uuid
  processed_at                        DateTime?            @db.Timestamp(6)
  created_at                          DateTime?            @default(now()) @db.Timestamp(6)
  updated_at                          DateTime?            @default(now()) @db.Timestamp(6)

  // Relations — matching production schema named aliases
  return_order_items                  return_order_items[]
  users_return_orders_admin_idTousers users?               @relation("return_orders_admin_idTousers", fields: [admin_id], references: [id])
  orders                              orders               @relation(fields: [order_id], references: [id])
  users_return_orders_user_idTousers  users                @relation("return_orders_user_idTousers", fields: [user_id], references: [id])

  @@index([order_id])
  @@index([user_id])
}
