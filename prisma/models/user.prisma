enum UserRole {
  USER
  ADMIN
  SELLER
  VENDOR
  RIDER
}

model users {
  id                                                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                     String                  @unique
  photo_url                                                 String?
  role                                                      UserRole                @default(USER)
  password                                                  String?
  password_reset_token                                      String?
  password_reset_expires                                    DateTime?               @db.Timestamptz(6)
  created_at                                                DateTime?               @default(now()) @db.Timestamptz(6)
  last_login                                                DateTime?               @db.Timestamptz(6)
  is_active                                                 Boolean?                @default(true)
  phone                                                     String?
  avatar                                                    String?
  name                                                      String?
  account_type                                              String?
  company_name                                              String?
  street_address                                            String?                 @db.VarChar
  suite_unit_floor                                          String?                 @db.VarChar
  house_number                                              String?                 @db.VarChar
  locality                                                  String?                 @db.VarChar
  city                                                      String?                 @db.VarChar
  state                                                     String?                 @db.VarChar
  postal_code                                               String?                 @db.VarChar
  country                                                   String?                 @default("India") @db.VarChar
  landmark                                                  String?                 @db.VarChar
  gstin                                                     String?                 @unique @db.VarChar
  pan                                                       String?                 @unique @db.VarChar
  adhaar_no                                                 String?                 @unique @db.VarChar
  first_name                                                String?
  last_name                                                 String?
  business_type                                             String?
  user_image                                                String?
  fcm_token                                                 String?           @db.Text         // Firebase Cloud Messaging token for push notifications

  // Relations — exact production schema names and aliases
  Post                                                      Post[]
  cart_items                                                cart_items[]
  coupon_usage                                              coupon_usage[]
  enquiries                                                 enquiries[]
  orders                                                    orders[]
  return_orders_return_orders_admin_idTousers               return_orders[]         @relation("return_orders_admin_idTousers")
  return_orders_return_orders_user_idTousers                return_orders[]         @relation("return_orders_user_idTousers")
  refund_requests_refund_requests_user_idTousers            refund_requests[]       @relation("refund_requests_user_idTousers")
  refund_requests_refund_requests_processed_byTousers       refund_requests[]       @relation("refund_requests_processed_byTousers")
  riders                                                    riders?
  sellers                                                   sellers?
  service_bookings                                          service_bookings[]
  stock_notify_requests                                     stock_notify_requests[]
  user_addresses                                            user_addresses[]
  user_notifications                                        user_notifications[]
  wallet_audit_logs                                         wallet_audit_logs[]
  wallet_transactions_wallet_transactions_created_byTousers wallet_transactions[]   @relation("wallet_transactions_created_byTousers")
  wallet_transactions_wallet_transactions_user_idTousers    wallet_transactions[]   @relation("wallet_transactions_user_idTousers")
  wallets_wallets_frozen_byTousers                          wallets[]               @relation("wallets_frozen_byTousers")
  wallets_wallets_user_idTousers                            wallets?                @relation("wallets_user_idTousers")
  wishlist_items                                            wishlist_items[]
  customer_addresses                                        customer_addresses[]
  shopping_lists                                            shopping_lists[]
}
