model rider_wage_logs {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rider_id                    String   @db.Uuid
  date                        DateTime @db.Date
  total_hours                 Decimal  @db.Decimal(5, 2)
  segments_count              Int      @default(1)
  is_eligible_for_minimum_wage Boolean @default(false)

  created_at                  DateTime @default(now()) @db.Timestamptz
  updated_at                  DateTime @default(now()) @db.Timestamptz

  // Relations
  rider                       riders   @relation(fields: [rider_id], references: [id], onDelete: Cascade)

  @@unique([rider_id, date])
  @@index([rider_id])
  @@index([date])
}
