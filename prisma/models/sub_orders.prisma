model sub_orders {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_order_id       String              @db.Uuid
  source_type           String              @db.VarChar // "division" | "zonal" | "seller"
  source_id             Int                 // warehouse_id
  seller_id             String?             @db.Uuid    // only set when source_type = "seller"

  fulfillment_status    String              @default("pending") @db.VarChar
  // pending → confirmed → picked → in_transit → delivered
  // also: dispatched_to_zonal_delivery, rider_pending, cancelled, return_to_source

  rider_id              String?             @db.Uuid
  pickup_sequence       Json?               @default("[]")
  estimated_delivery_at DateTime?           @db.Timestamptz

  created_at            DateTime            @default(now()) @db.Timestamptz
  updated_at            DateTime            @default(now()) @db.Timestamptz

  // Relations
  parent_order          orders              @relation(fields: [parent_order_id], references: [id], onDelete: Cascade)
  warehouse             warehouses          @relation(fields: [source_id], references: [id])
  sub_order_items       sub_order_items[]
  fulfillment_events    fulfillment_events[]

  @@index([parent_order_id])
  @@index([source_type])
  @@index([source_id])
  @@index([seller_id])
  @@index([fulfillment_status])
  @@index([rider_id])
}
