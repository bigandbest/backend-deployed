enum Vertical {
  grocery
  food
  service
  b2b
}

model products {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  description        String?
  vertical           Vertical           @default(grocery)
  category_id        String?            @db.Uuid
  subcategory_id     String?            @db.Uuid
  group_id           String?            @db.Uuid
  image              String?
  rating             Decimal?           @default(0) @db.Decimal
  review_count       Int?               @default(0)
  return_applicable  Boolean?           @default(false)
  return_days        Int?               @default(0)
  popular            Boolean?           @default(false)
  featured           Boolean?           @default(false)
  active             Boolean?           @default(true)
  has_variants       Boolean?           @default(false)
  created_at         DateTime?          @default(now()) @db.Timestamptz
  updated_at         DateTime?          @updatedAt @db.Timestamptz

  // Relations
  category           categories?        @relation(fields: [category_id], references: [id])
  subcategory        subcategories?     @relation(fields: [subcategory_id], references: [id])
  group              groups?            @relation(fields: [group_id], references: [id])
  variants           product_variants[]
  brands             product_brand[]
  reviews            product_reviews[]
  you_may_like       you_may_like[]
  product_enquiries  product_enquiries[]
  section_products   product_section_products[]
  quickpick_products quickpick_group_product[]
  recommended_stores product_recommended_store[]
  wishlist_items     wishlist_items[]

  @@index([vertical])
  @@index([category_id])
  @@index([active])
}
