model referral_fraud_logs {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String?   @db.Uuid
  referral_code            String?   @db.VarChar(20)
  referral_transaction_id  String?   @db.Uuid
  fraud_type               String    @db.VarChar(100)
  severity                 String    @db.VarChar(20)
  description              String?
  ip_address               String?   @db.VarChar
  user_agent               String?
  detected_by              String?   @db.VarChar(50)
  resolved                 Boolean   @default(false)
  resolved_at              DateTime? @db.Timestamptz
  resolved_by              String?   @db.VarChar
  resolution_note          String?
  created_at               DateTime  @default(now()) @db.Timestamptz
  // Marketing Control Center Q2 — shared with affiliate via the program discriminator, plus the
  // review/status columns the admin review flow already expected (migration 20260916210000).
  program                  String    @default("REFERRAL") @db.VarChar(20)
  status                   String    @default("PENDING_REVIEW") @db.VarChar(30)
  reviewed_by              String?   @db.Uuid
  reviewed_at              DateTime? @db.Timestamptz
  review_notes             String?
  action_taken             String?   @db.VarChar(100)
  action_taken_by          String?   @db.Uuid
  action_taken_at          DateTime? @db.Timestamptz
}
