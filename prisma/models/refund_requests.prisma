model refund_requests {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                 String    @db.Uuid
  user_id                  String    @db.Uuid
  refund_amount            Decimal   @db.Decimal
  refund_type              String    @db.VarChar
  payment_method           String?   @db.VarChar
  original_payment_id      String?   @db.VarChar
  bank_account_holder_name String?   @db.VarChar
  bank_account_number      String?   @db.VarChar
  bank_ifsc_code           String?   @db.VarChar
  bank_name                String?   @db.VarChar
  refund_mode              String?   @default("bank_transfer") @db.VarChar
  status                   String?   @default("pending") @db.VarChar
  admin_notes              String?
  processed_by             String?   @db.Uuid
  processed_at             DateTime? @db.Timestamp(6)
  razorpay_refund_id       String?   @db.VarChar
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  updated_at               DateTime? @default(now()) @db.Timestamp(6)

  // Relations
  orders                              orders  @relation(fields: [order_id], references: [id])
  users_refund_requests_user_idTousers users   @relation("refund_requests_user_idTousers", fields: [user_id], references: [id])
  users_refund_requests_processed_by  users?  @relation("refund_requests_processed_byTousers", fields: [processed_by], references: [id])

  @@index([order_id])
  @@index([user_id])
  @@index([status])
}
