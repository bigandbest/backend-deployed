model affiliate_commissions {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id         String    @db.Uuid
  affiliate_order_id   String    @db.Uuid
  order_id             String    @db.Uuid
  order_value          Decimal   @db.Decimal(10, 2)
  base_commission_rate Decimal   @db.Decimal(10, 2)
  tier_bonus           Decimal   @default(0) @db.Decimal(10, 2)
  effective_rate       Decimal   @db.Decimal(10, 2)
  gross_commission     Decimal   @db.Decimal(10, 2)
  net_commission       Decimal   @db.Decimal(10, 2)
  tds_applicable       Boolean   @default(false)
  tds_rate             Decimal   @default(0) @db.Decimal(10, 2)
  tds_amount           Decimal   @default(0) @db.Decimal(10, 2)
  final_amount         Decimal   @db.Decimal(10, 2)
  status               String    @default("PENDING")
  payout_id            String?   @db.Uuid
  order_date           DateTime  @db.Timestamptz
  qualified_at         DateTime? @db.Timestamptz
  approved_at          DateTime? @db.Timestamptz
  paid_at              DateTime? @db.Timestamptz
  cancelled_at         DateTime? @db.Timestamptz
  cancellation_reason  String?
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  // Relations
  affiliate_profiles affiliate_profiles @relation(fields: [affiliate_id], references: [id])
  affiliate_orders   affiliate_orders   @relation(fields: [affiliate_order_id], references: [id])
  affiliate_payouts  affiliate_payouts? @relation(fields: [payout_id], references: [id])
}
