model add_banner {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  image_url          String?
  banner_type        String?
  link               String?
  active             Boolean?            @default(true)
  position           String?
  is_mobile          Boolean?            @default(false)
  updated_at         DateTime?           @default(now()) @db.Timestamptz

  // Relations
  recommended_stores recommended_store[]
}
