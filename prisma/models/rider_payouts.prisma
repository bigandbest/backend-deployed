model rider_payouts {
  id                  Int       @id @default(autoincrement())
  rider_id            String    @db.Uuid
  sub_order_id        String    @db.Uuid
  parent_order_id     String    @db.Uuid
  route_type          String    @db.VarChar(10)     // 'SELLER' | 'WAREHOUSE'

  // GPS coordinates
  pickup_latitude     Decimal?  @db.Decimal(10, 7)  // rider location at pickup moment
  pickup_longitude    Decimal?  @db.Decimal(10, 7)
  source_latitude     Decimal?  @db.Decimal(10, 7)  // seller or warehouse lat
  source_longitude    Decimal?  @db.Decimal(10, 7)
  delivery_latitude   Decimal?  @db.Decimal(10, 7)  // customer lat
  delivery_longitude  Decimal?  @db.Decimal(10, 7)

  // Distance breakdown
  leg1_km             Decimal?  @db.Decimal(5, 2)   // rider → source
  leg2_km             Decimal?  @db.Decimal(5, 2)   // source → customer
  total_km            Decimal?  @db.Decimal(5, 2)

  // Payout
  slab_id             Int?
  payout_amount       Decimal?  @db.Decimal(10, 2)
  status              String    @default("PENDING") @db.VarChar(20)
  // PENDING | APPROVED | PAID | DISPUTED | MANUAL_REVIEW

  calculated_at       DateTime? @db.Timestamptz
  paid_at             DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  // Relations
  rider               riders          @relation(fields: [rider_id], references: [id])
  sub_order           sub_orders      @relation(fields: [sub_order_id], references: [id])
  slab                payout_slabs?   @relation(fields: [slab_id], references: [id])
  payout_disputes     payout_disputes[]

  @@unique([sub_order_id])  // idempotency: one payout per sub-order
  @@index([rider_id])
  @@index([status])
  @@index([parent_order_id])
}
