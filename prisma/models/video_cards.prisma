model video_cards {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  video_url     String
  thumbnail_url String?
  active        Boolean?  @default(true)
  position      Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @default(now()) @db.Timestamptz
}
