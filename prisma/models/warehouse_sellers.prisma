model warehouse_sellers {
  id            Int       @id @default(autoincrement())
  warehouse_id  Int
  seller_id     String    @db.Uuid
  is_active     Boolean   @default(true)
  assigned_at   DateTime  @default(now()) @db.Timestamptz

  // Relations — using plural names to match production schema
  warehouses    warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  sellers       sellers    @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, seller_id])
  @@index([warehouse_id])
  @@index([seller_id])
}
