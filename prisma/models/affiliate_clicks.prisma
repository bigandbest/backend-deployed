model affiliate_clicks {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id      String    @db.Uuid
  link_id           String?   @db.Uuid
  link_code         String?
  affiliate_code    String
  visitor_id        String?
  user_id           String?   @db.Uuid
  ip_address        String?
  user_agent        String?
  device_type       String?
  country           String?
  referrer_url      String?
  destination_url   String
  cookie_expires_at DateTime? @db.Timestamptz
  is_converted      Boolean   @default(false)
  converted_at      DateTime? @db.Timestamptz
  order_id          String?   @db.Uuid
  is_suspicious     Boolean   @default(false)
  clicked_at        DateTime  @default(now()) @db.Timestamptz

  // Relations
  affiliate_profiles affiliate_profiles @relation(fields: [affiliate_id], references: [id])
  affiliate_links    affiliate_links?   @relation(fields: [link_id], references: [id])
}
