// Audit trail for homepage section administration (precedent: payout_audit_log,
// referral_admin_logs). section_id is nullable + SetNull so history survives
// a section delete.
model section_audit_log {
  id         BigInt   @id @default(autoincrement())
  section_id Int?
  actor_id   String?  @db.VarChar(64)
  actor_role String?  @db.VarChar(32)
  // SECTION_CREATED | SECTION_UPDATED | SECTION_TOGGLED | SECTION_REORDERED | MAPPING_CHANGED | SECTION_DELETED
  action     String   @db.VarChar(40)
  diff       Json?    @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz

  section    product_sections? @relation(fields: [section_id], references: [id], onDelete: SetNull)

  @@index([section_id, created_at], map: "idx_section_audit_log_section_time")
}
