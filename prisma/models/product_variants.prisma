model product_variants {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id               String                    @db.Uuid
  sku                      String                    @unique @db.VarChar
  title                    String                    @db.VarChar
  price                    Decimal                   @db.Decimal
  old_price                Decimal?                  @db.Decimal
  discount_percentage      Int?                      @default(0)
  packaging_details        String?
  photo_url                String?                   @db.VarChar
  net_quantity             String?
  gst_rate_override        Decimal?                  @db.Decimal
  cess_rate_override       Decimal?                  @db.Decimal
  features                 String?
  is_default               Boolean?                  @default(false)
  active                   Boolean?                  @default(true)
  shipping_amount          Decimal?                  @default(0) @db.Decimal
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @db.Timestamptz(6)

  // Relations — matching backup schema exactly
  cart_items               cart_items[]
  inventory                inventory[]
  order_items              order_items[]
  product_media            product_media[]
  products                 products                  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse_stock          product_warehouse_stock[]
  seller_products          seller_products[]
  service_bookings         service_bookings[]
  variant_attributes       variant_attributes[]
  sub_order_items          sub_order_items[]
  bulk_pricing_tiers       bulk_pricing_tiers[]

  @@index([active])
  @@index([product_id])
  @@index([product_id, active])
  @@index([sku])
}
