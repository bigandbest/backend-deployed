  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  image_url   String?
  description String?
  is_active   Boolean? @default(false)
  banner_id   String?  @db.Uuid

  // Relations
  banner      add_banner?                   @relation(fields: [banner_id], references: [id])
  products    product_recommended_store[]
}


// --- Model: scheduled_order_slots.prisma ---
model scheduled_order_slots {
  id             Int                   @id @default(autoincrement())
  warehouse_id   Int
  slot_id        Int
  scheduled_date DateTime              @db.Date
  current_count  Int?                  @default(0)
  created_at     DateTime?             @default(now()) @db.Timestamptz
  updated_at     DateTime?             @default(now()) @db.Timestamptz

  // Relations
  warehouse      warehouses            @relation(fields: [warehouse_id], references: [id])
  slot           scheduling_time_slots @relation(fields: [slot_id], references: [id])
}


// --- Model: scheduled_orders.prisma ---
model scheduled_orders {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String                  @db.Uuid
  cart_items             Json
  address_id             String?                 @db.Uuid
  scheduled_at           DateTime                @db.Timestamptz
  timezone               String                  @default("UTC") @db.VarChar
  created_at             DateTime?               @default(now()) @db.Timestamptz
  updated_at             DateTime?               @default(now()) @db.Timestamptz
  status                 String                  @default("SCHEDULED") @db.VarChar
  payment_method         String                  @db.VarChar
  payment_intent_id      String?                 @db.VarChar
  payment_status         String?                 @default("PENDING") @db.VarChar
  total_amount           Decimal                 @db.Decimal
  execution_attempts     Int?                    @default(0)
  last_execution_attempt DateTime?               @db.Timestamptz
  idempotency_key        String                  @unique @db.VarChar
  lock_token             String?                 @db.VarChar
  lock_expires_at        DateTime?               @db.Timestamptz
  placed_order_id        String?                 @db.Uuid
  failure_reason         String?
  metadata               Json?                   @default("{}")
  warehouse_id           Int?
  slot_id                Int?
  scheduled_date         DateTime?               @db.Date

  // Relations
  warehouse              warehouses?             @relation(fields: [warehouse_id], references: [id])
  slot                   scheduling_time_slots?  @relation(fields: [slot_id], references: [id])
  execution_logs         order_execution_logs[]
  payment_retry_logs     payment_retry_logs[]
}


// --- Model: scheduling_time_slots.prisma ---
model scheduling_time_slots {
  id           Int       @id @default(autoincrement())
  start_time   DateTime  @db.Time
  end_time     DateTime  @db.Time
  display_name String    @db.VarChar
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamptz
  updated_at   DateTime? @default(now()) @db.Timestamptz

  // Relations
  warehouse_configs warehouse_scheduling_config[]
  order_slots       scheduled_order_slots[]
  scheduled_orders  scheduled_orders[]
}


// --- Model: section_subcategory_mappings.prisma ---
model section_subcategory_mappings {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section_id     Int
  subcategory_id String           @db.Uuid
  display_order  Int?             @default(0)
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamptz
  updated_at     DateTime?        @default(now()) @db.Timestamptz

  // Relations
  section        product_sections @relation(fields: [section_id], references: [id])
  subcategory    subcategories    @relation(fields: [subcategory_id], references: [id])
}


// --- Model: service_bookings.prisma ---
enum ServiceStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

model service_bookings {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_item_id String?           @unique @db.Uuid
  variant_id    String            @db.Uuid
  user_id       String            @db.Uuid
  scheduled_at  DateTime          @db.Timestamptz
  address_id    String?           @db.Uuid
  provider_id   String?           @db.Uuid
  status        ServiceStatus     @default(pending)
  notes         String?
  created_at    DateTime          @default(now()) @db.Timestamptz
  updated_at    DateTime          @updatedAt @db.Timestamptz

  // Relations
  variant       product_variants  @relation(fields: [variant_id], references: [id])
  user          users             @relation(fields: [user_id], references: [id])
  address       user_addresses?   @relation(fields: [address_id], references: [id])
  order_item    order_items?      @relation(fields: [order_item_id], references: [id])

  @@index([user_id])
  @@index([provider_id])
  @@index([scheduled_at])
  @@index([status])
}


