  @@index([referrer_id])
  @@index([referee_id])
  @@index([referral_code_used])
  @@index([order_id])
  @@index([status])
  @@index([created_at])
  @@map("referral_transactions")
}

// --- Model: referral_rewards.prisma ---
model referral_rewards {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  user_profile_id          String    @db.Uuid
  amount                   Decimal   @db.Decimal
  original_amount          Decimal   @db.Decimal
