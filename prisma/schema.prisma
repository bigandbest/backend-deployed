// --- Model: user_referral_profiles.prisma ---
model user_referral_profiles {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @unique @db.Uuid
  referral_code           String    @unique
  referral_code_active    Boolean?  @default(true)
  referral_code_created_at DateTime? @default(now()) @db.Timestamptz(6)
  total_referrals         Int       @default(0)
  successful_referrals    Int       @default(0)
  pending_referrals       Int       @default(0)
  failed_referrals        Int       @default(0)
  total_earnings          Decimal   @default(0) @db.Decimal
  available_balance       Decimal   @default(0) @db.Decimal
  pending_balance         Decimal   @default(0) @db.Decimal
  withdrawn_amount        Decimal   @default(0) @db.Decimal
  expired_amount          Decimal   @default(0) @db.Decimal
  used_for_purchase       Decimal   @default(0) @db.Decimal
  was_referred            Boolean?  @default(false)
  referred_by_user_id     String?   @db.Uuid
  referred_by_code        String?
  referred_at             DateTime? @db.Timestamptz(6)
  referral_bonus_received Boolean?  @default(false)
  status                  String    @default("ACTIVE")
  is_blocked              Boolean?  @default(false)
  block_reason            String?
  blocked_at              DateTime? @db.Timestamptz(6)
  blocked_by              String?   @db.Uuid
  current_tier            String    @default("BRONZE")
  tier_updated_at         DateTime? @db.Timestamptz(6)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  referral_transactions   referral_transactions[]
  referral_rewards        referral_rewards[]
  referral_withdrawals    referral_withdrawals[]

  @@index([user_id])
  @@index([referral_code])
  @@index([referred_by_user_id])
  @@index([status])
  @@map("user_referral_profiles")
}

// --- Model: referral_transactions.prisma ---
model referral_transactions {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrer_id             String    @db.Uuid
  referrer_profile_id     String    @db.Uuid
  referral_code_used      String
  referee_id              String    @db.Uuid
  referee_email           String?
  referee_name            String?
  referee_phone           String?
  status                  String    @default("PENDING")
  status_history          Json?
  order_id                String?   @unique @db.Uuid
  order_number            String?
  order_amount            Decimal?  @db.Decimal
  order_date              DateTime? @db.Timestamptz(6)
  order_status            String?
  delivered_at            DateTime? @db.Timestamptz(6)
  return_window_starts_at DateTime? @db.Timestamptz(6)
  return_window_ends_at   DateTime? @db.Timestamptz(6)
  is_returned             Boolean?  @default(false)
  return_type             String?
  return_amount           Decimal?  @db.Decimal
  returned_at             DateTime? @db.Timestamptz(6)
  referrer_reward_amount  Decimal?  @db.Decimal
  referee_reward_amount   Decimal?  @db.Decimal
  referrer_reward_id      String?   @db.Uuid
  referee_reward_id       String?   @db.Uuid
  reward_credited_at      DateTime? @db.Timestamptz(6)
  failure_reason          String?
  failed_at               DateTime? @db.Timestamptz(6)
