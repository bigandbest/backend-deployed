  user_id                        String                @unique @db.Uuid
  balance                        Decimal               @default(0.00) @db.Decimal
  is_frozen                      Boolean?              @default(false)
  frozen_reason                  String?
  frozen_by                      String?               @db.Uuid
  frozen_at                      DateTime?             @db.Timestamptz(6)
  created_at                     DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime?             @default(now()) @db.Timestamptz(6)
  version                        Int?                  @default(1)
  wallet_audit_logs              wallet_audit_logs[]
  wallet_transactions            wallet_transactions[]
  users_wallets_frozen_byTousers users?                @relation("wallets_frozen_byTousers", fields: [frozen_by], references: [id])
  users_wallets_user_idTousers   users                 @relation("wallets_user_idTousers", fields: [user_id], references: [id])
}

model warehouse_pincodes {
  id            Int        @id @default(autoincrement())
  warehouse_id  Int
  pincode       String     @db.VarChar
  city          String?    @db.VarChar
  state         String?    @db.VarChar
  delivery_days Int?       @default(3)
  is_active     Boolean?   @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  warehouse     warehouses @relation(fields: [warehouse_id], references: [id])
}

model warehouse_riders {
  id           Int        @id @default(autoincrement())
  warehouse_id Int
  rider_id     String     @db.Uuid
  is_active    Boolean    @default(true)
  assigned_at  DateTime   @default(now()) @db.Timestamptz(6)
  riders       riders     @relation(fields: [rider_id], references: [id], onDelete: Cascade)
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, rider_id])
  @@index([warehouse_id])
  @@index([rider_id])
}

model warehouse_scheduling_config {
  id                      Int                   @id @default(autoincrement())
  warehouse_id            Int
  slot_id                 Int
  max_capacity            Int                   @default(20)
  scheduling_window_hours Int                   @default(24)
  is_active               Boolean?              @default(true)
  days_of_week            Json?                 @default("[\"monday\", \"tuesday\", \"wednesday\", \"thursday\", \"friday\", \"saturday\", \"sunday\"]")
  created_at              DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?             @default(now()) @db.Timestamptz(6)
  scheduling_time_slots   scheduling_time_slots @relation(fields: [slot_id], references: [id])
  warehouses              warehouses            @relation(fields: [warehouse_id], references: [id])
}

model warehouse_sellers {
  id           Int        @id @default(autoincrement())
  warehouse_id Int
  seller_id    String     @db.Uuid
  is_active    Boolean    @default(true)
  assigned_at  DateTime   @default(now()) @db.Timestamptz(6)
  sellers      sellers    @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, seller_id])
  @@index([warehouse_id])
  @@index([seller_id])
}

model warehouse_zones {
  id             Int            @id @default(autoincrement())
  warehouse_id   Int
  zone_id        Int
  priority       Int?           @default(1)
  is_active      Boolean?       @default(true)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  warehouses     warehouses     @relation(fields: [warehouse_id], references: [id])
  delivery_zones delivery_zones @relation(fields: [zone_id], references: [id])
}

model warehouses {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @unique @db.VarChar
  type                        String                        @db.VarChar
  location                    String?                       @db.VarChar
  address                     String?
  contact_person              String?                       @db.VarChar
  contact_phone               String?                       @db.VarChar
  contact_email               String?                       @db.VarChar
  is_active                   Boolean?                      @default(true)
  capacity_limit              Int?
  current_utilization         Int?                          @default(0)
  operational_hours           Json?                         @default("{}")
  facilities                  Json?                         @default("{}")
  created_at                  DateTime?                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamptz(6)
  created_by                  Int?
  parent_warehouse_id         Int?
  hierarchy_level             Int?                          @default(0)
  latitude                    Decimal?                      @db.Decimal(10, 7)
  longitude                   Decimal?                      @db.Decimal(10, 7)
  geocode_status              String?                       @default("PENDING") @db.VarChar(20)
  inventory                   inventory[]
  order_items                 order_items[]
  product_warehouse_stock     product_warehouse_stock[]
  scheduled_order_slots       scheduled_order_slots[]
  scheduled_orders            scheduled_orders[]
  seller_products             seller_products[]
  stock_movements             stock_movements[]
  sub_orders                  sub_orders[]
  warehouse_pincodes          warehouse_pincodes[]
  warehouse_riders            warehouse_riders[]
  warehouse_scheduling_config warehouse_scheduling_config[]
  warehouse_sellers           warehouse_sellers[]
  warehouse_zones             warehouse_zones[]
  parent_warehouse            warehouses?                   @relation("warehouse_hierarchy", fields: [parent_warehouse_id], references: [id])
  child_warehouses            warehouses[]                  @relation("warehouse_hierarchy")
}

model wishlist_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@index([product_id])
}

model you_may_like {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String?   @db.Uuid
  products   products? @relation(fields: [product_id], references: [id])
}

model zone_pincodes {
  id             Int            @id @default(autoincrement())
  zone_id        Int
  pincode        String         @db.VarChar
  city           String?        @db.VarChar
  state          String?        @db.VarChar
  is_active      Boolean?       @default(true)
