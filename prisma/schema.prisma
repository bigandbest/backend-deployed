// --- Model: warehouse_scheduling_config.prisma ---
model warehouse_scheduling_config {
  id                      Int                   @id @default(autoincrement())
  warehouse_id            Int
  slot_id                 Int
  max_capacity            Int                   @default(20)
  scheduling_window_hours Int                   @default(24)
  is_active               Boolean?              @default(true)
  days_of_week            Json?                 @default("[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\",\"saturday\",\"sunday\"]")
  created_at              DateTime?             @default(now()) @db.Timestamptz
  updated_at              DateTime?             @default(now()) @db.Timestamptz

  // Relations
  warehouse               warehouses            @relation(fields: [warehouse_id], references: [id])
  slot                    scheduling_time_slots @relation(fields: [slot_id], references: [id])
}


// --- Model: warehouse_zones.prisma ---
model warehouse_zones {
  id           Int            @id @default(autoincrement())
  warehouse_id Int
  zone_id      Int
  priority     Int?           @default(1)
  is_active    Boolean?       @default(true)
  created_at   DateTime?      @default(now()) @db.Timestamptz

  // Relations
  warehouse    warehouses     @relation(fields: [warehouse_id], references: [id])
  zone         delivery_zones @relation(fields: [zone_id], references: [id])
}


// --- Model: warehouses.prisma ---
model warehouses {
  id                  Int               @id @default(autoincrement())
  name                String            @unique @db.VarChar
  type                String            @db.VarChar
  location            String?           @db.VarChar
  address             String?
  contact_person      String?           @db.VarChar
  contact_phone       String?           @db.VarChar
  contact_email       String?           @db.VarChar
  is_active           Boolean?          @default(true)
  capacity_limit      Int?
  current_utilization Int?              @default(0)
  operational_hours   Json?             @default("{}")
  facilities          Json?             @default("{}")
  created_at          DateTime?         @default(now()) @db.Timestamptz
  updated_at          DateTime?         @default(now()) @db.Timestamptz
  created_by          Int?
  parent_warehouse_id Int?
  hierarchy_level     Int?              @default(0)

  // Relations
  parent_warehouse    warehouses?       @relation("WarehouseHierarchy", fields: [parent_warehouse_id], references: [id])
  child_warehouses    warehouses[]      @relation("WarehouseHierarchy")
  movements           stock_movements[]
  warehouse_zones     warehouse_zones[]
  order_items         order_items[]
  scheduling_configs  warehouse_scheduling_config[]
  scheduled_slots     scheduled_order_slots[]
  scheduled_orders    scheduled_orders[]
  warehouse_pincodes  warehouse_pincodes[]
  inventory           inventory[]
}


// --- Model: wishlist_items.prisma ---
model wishlist_items {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  product_id String    @db.Uuid
  added_at   DateTime  @default(now()) @db.Timestamptz

  // Relations
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@index([product_id])
}


// --- Model: you_may_like.prisma ---
model you_may_like {
