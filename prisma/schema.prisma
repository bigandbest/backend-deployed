  referrer_reward_amount   Decimal   @default(75) @db.Decimal
  referee_reward_amount    Decimal   @default(75) @db.Decimal
  max_earning_per_user     Decimal   @default(1000) @db.Decimal
  reward_validity_days     Int       @default(7)
  min_order_value          Decimal   @default(200) @db.Decimal
  applicable_first_order   Boolean?  @default(true)
  return_window_days       Int       @default(7)
  min_withdrawal_amount    Decimal   @default(100) @db.Decimal
  max_withdrawals_per_month Int      @default(10)
  tiered_rewards_enabled   Boolean?  @default(false)
