// --- Model: wallet_transactions.prisma ---
model wallet_transactions {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id           String    @db.Uuid
  user_id             String    @db.Uuid
  transaction_type    String    @db.VarChar
  amount              Decimal   @db.Decimal
  balance_before      Decimal   @db.Decimal
  balance_after       Decimal   @db.Decimal
  reference_type      String?   @db.VarChar
  reference_id        String?   @db.Uuid
  razorpay_order_id   String?   @db.VarChar
  razorpay_payment_id String?   @db.VarChar
  description         String?
  metadata            Json?     @default("{}")
  status              String?   @default("COMPLETED") @db.VarChar
  idempotency_key     String?   @unique @db.VarChar
  created_by          String?   @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz

  // Relations
  wallet              wallets   @relation(fields: [wallet_id], references: [id])
  user                users     @relation("UserTransactions", fields: [user_id], references: [id])
  creator             users?    @relation("TransactionCreator", fields: [created_by], references: [id])
}


// --- Model: wallets.prisma ---
model wallets {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @unique @db.Uuid
  balance       Decimal   @default(0.00) @db.Decimal
  is_frozen     Boolean?  @default(false)
  frozen_reason String?
  frozen_by     String?   @db.Uuid
  frozen_at     DateTime? @db.Timestamptz
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @default(now()) @db.Timestamptz
  version       Int?      @default(1)

  // Relations
  user          users     @relation("UserWallet", fields: [user_id], references: [id])
  transactions  wallet_transactions[]
  admin_frozen_by users?  @relation("WalletFreezer", fields: [frozen_by], references: [id])
  audit_logs    wallet_audit_logs[]
}


