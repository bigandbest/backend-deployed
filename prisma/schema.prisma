  cancelled_by             String?   @db.Uuid
  cancelled_at             DateTime? @db.Timestamptz(6)
  cancellation_reason      String?
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at               DateTime? @default(now()) @db.Timestamptz(6)

  user_profile             user_referral_profiles @relation(fields: [user_profile_id], references: [id])
  usage_records            referral_reward_usages[]

  @@index([user_id])
  @@index([user_profile_id])
  @@index([status])
  @@index([expires_at])
  @@index([credited_at])
  @@map("referral_rewards")
}

// --- Model: referral_reward_usages.prisma ---
model referral_reward_usages {
