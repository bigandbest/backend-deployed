  street_address   String               @db.VarChar
  suite_unit_floor String?              @db.VarChar
  house_number     String?              @db.VarChar
  locality         String?              @db.VarChar
  city             String               @db.VarChar
  state            String               @db.VarChar
  postal_code      String               @db.VarChar
  country          String?              @default("India") @db.VarChar
  landmark         String?              @db.VarChar
  gstin            String?              @db.VarChar
  created_at       DateTime?            @default(now()) @db.Timestamptz
  updated_at       DateTime?            @default(now()) @db.Timestamptz

