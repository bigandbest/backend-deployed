// --- Model: user_notifications.prisma ---
model user_notifications {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?   @db.Uuid
  type         String    @db.VarChar
  title        String    @db.VarChar
  message      String
  related_id   String?   @db.Uuid
  related_type String?   @db.VarChar
  is_read      Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp
  read_at      DateTime? @db.Timestamp

  // Relations
  user         users?    @relation(fields: [user_id], references: [id])
}


// --- Model: variant_attributes.prisma ---
model variant_attributes {
  id              Int               @id @default(autoincrement())
  variant_id      String            @db.Uuid
  attribute_name  String            @db.VarChar // weight, size, duration, color, moq, unit, tier, speed
  attribute_value String            @db.VarChar // 1kg, XL, 60min, Red, 50, item, premium, express
  created_at      DateTime          @default(now()) @db.Timestamptz

  // Relations
  variant         product_variants  @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([variant_id, attribute_name])
  @@index([attribute_name, attribute_value])
}


// --- Model: video_cards.prisma ---
model video_cards {
