  order_date            DateTime                @db.Timestamptz(6)
  order_status          String
  gross_order_value     Decimal                 @db.Decimal(10, 2)
  discount_amount       Decimal                 @default(0) @db.Decimal(10, 2)
  net_order_value       Decimal                 @db.Decimal(10, 2)
  is_returned           Boolean                 @default(false)
  return_amount         Decimal                 @default(0) @db.Decimal(10, 2)
  final_order_value     Decimal                 @db.Decimal(10, 2)
  delivered_at          DateTime?               @db.Timestamptz(6)
  return_window_ends_at DateTime?               @db.Timestamptz(6)
  commission_status     String                  @default("PENDING")
  commission_rate       Decimal?                @db.Decimal(10, 2)
  commission_amount     Decimal?                @db.Decimal(10, 2)
  tier_bonus            Decimal                 @default(0) @db.Decimal(10, 2)
  final_commission      Decimal?                @db.Decimal(10, 2)
  is_fraud_suspected    Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @updatedAt @db.Timestamptz(6)
  processed_at          DateTime?               @db.Timestamptz(6)
  affiliate_commissions affiliate_commissions[]
  affiliate_profiles    affiliate_profiles      @relation(fields: [affiliate_id], references: [id])
}

model affiliate_commissions {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id         String             @db.Uuid
  affiliate_order_id   String             @db.Uuid
  order_id             String             @db.Uuid
  order_value          Decimal            @db.Decimal(10, 2)
  base_commission_rate Decimal            @db.Decimal(10, 2)
  tier_bonus           Decimal            @default(0) @db.Decimal(10, 2)
  effective_rate       Decimal            @db.Decimal(10, 2)
  gross_commission     Decimal            @db.Decimal(10, 2)
  net_commission       Decimal            @db.Decimal(10, 2)
  tds_applicable       Boolean            @default(false)
  tds_rate             Decimal            @default(0) @db.Decimal(10, 2)
  tds_amount           Decimal            @default(0) @db.Decimal(10, 2)
  final_amount         Decimal            @db.Decimal(10, 2)
  status               String             @default("PENDING")
  payout_id            String?            @db.Uuid
  order_date           DateTime           @db.Timestamptz(6)
  qualified_at         DateTime?          @db.Timestamptz(6)
  approved_at          DateTime?          @db.Timestamptz(6)
  paid_at              DateTime?          @db.Timestamptz(6)
  cancelled_at         DateTime?          @db.Timestamptz(6)
  cancellation_reason  String?
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @updatedAt @db.Timestamptz(6)
  affiliate_profiles   affiliate_profiles @relation(fields: [affiliate_id], references: [id])
  affiliate_orders     affiliate_orders   @relation(fields: [affiliate_order_id], references: [id])
  affiliate_payouts    affiliate_payouts? @relation(fields: [payout_id], references: [id])
}

model affiliate_payouts {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_id          String                  @db.Uuid
  payout_number         String                  @unique
  payout_period         String?
  gross_amount          Decimal                 @db.Decimal(10, 2)
  tds_amount            Decimal                 @default(0) @db.Decimal(10, 2)
  net_amount            Decimal                 @db.Decimal(10, 2)
  commission_count      Int                     @default(0)
  payment_method        String                  @default("BANK_TRANSFER")
  bank_name             String?
  bank_account_number   String?
  bank_ifsc_code        String?
  account_holder_name   String?
  upi_id                String?
  status                String                  @default("PENDING")
  processed_by          String?                 @db.Uuid
  processed_at          DateTime?               @db.Timestamptz(6)
  transaction_id        String?
  payment_proof         String?
  failure_reason        String?
  admin_notes           String?
  period_start_date     DateTime?               @db.Timestamptz(6)
  period_end_date       DateTime?               @db.Timestamptz(6)
  requested_at          DateTime                @default(now()) @db.Timestamptz(6)
  completed_at          DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @updatedAt @db.Timestamptz(6)
  affiliate_commissions affiliate_commissions[]
  affiliate_profiles    affiliate_profiles      @relation(fields: [affiliate_id], references: [id])
}

model affiliate_category_commissions {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id          String   @unique @db.Uuid
  category_name        String?
  category_level       String?
  base_commission_rate Decimal  @db.Decimal(10, 2)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)
  updated_by           String?  @db.Uuid
}

model otpVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @db.VarChar
  otp       String   @db.VarChar(6)
  type      String   @db.VarChar(50)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([phone])
  @@index([expiresAt])
}

