  referral_transaction_id  String?   @db.Uuid
  source_type              String?
  source_description       String?
  credited_at              DateTime? @default(now()) @db.Timestamptz(6)
  expires_at               DateTime  @db.Timestamptz(6)
  status                   String    @default("ACTIVE")
  used_amount              Decimal   @default(0) @db.Decimal
  remaining_amount         Decimal   @db.Decimal
  expiry_reminder_sent     Boolean?  @default(false)
  expiry_reminder_sent_at  DateTime? @db.Timestamptz(6)
  urgent_reminder_sent     Boolean?  @default(false)
  urgent_reminder_sent_at  DateTime? @db.Timestamptz(6)
  expired_at               DateTime? @db.Timestamptz(6)
