generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model about_us_content {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  banner_image_url String?
  title            String?   @default("About Our Company") @db.VarChar
  subtitle         String?   @default("About Big&Best") @db.VarChar
  heading          String?   @default("Big&Best Mart") @db.VarChar
  content          String?
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  mission          String?
  story            String?
  values           String?
  vision           String?
  why_choose_us    String?
}

model add_banner {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  image_url   String?
  banner_type String?
  description String?       @db.VarChar
  link        String?
  active      Boolean?      @default(true)
  position    String?
  is_mobile   Boolean?      @default(false)
  updated_at  DateTime?     @default(now()) @db.Timestamptz(6)
  daily_deals daily_deals[]
}

model banners {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String              @db.VarChar
  subtitle           String?             @db.VarChar
  description        String?             @db.VarChar
  image_url          String?
  link               String?             @db.VarChar
  banner_type        String?             @db.VarChar
  position           String?             @db.VarChar
  bg_color           String?             @db.VarChar
  button_text        String?             @db.VarChar
  discount_text      String?             @db.VarChar
  active             Boolean?            @default(true)
  is_mobile          Boolean?            @default(false)
  display_order      Int?                @default(0)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  recommended_stores recommended_store[]
}

model brand {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  image_url String?
  products  product_brand[]
}

model cart_items {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String           @db.Uuid
  variant_id     String           @db.Uuid
  quantity       Int              @default(1)
  added_at       DateTime         @default(now()) @db.Timestamptz(6)
  is_bid_product Boolean?         @default(false)
  locked_bid_id  Int?
  bid_unit_price Decimal?         @db.Decimal
  user           users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  variant        product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([variant_id])
}

model categories {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  description                String?
  image_url                  String?
  featured                   Boolean?                     @default(false)
  icon                       String?
  active                     Boolean?                     @default(true)
  product_section_categories product_section_categories[]
  products                   products[]
  subcategories              subcategories[]
}

model certifications {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar
  image_url   String
  description String?
  active      Boolean?  @default(true)
  sort_order  Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model charge_settings {
  id              Int       @id @default(1)
  handling_charge Decimal   @default(0) @db.Decimal
  surge_charge    Decimal   @default(0) @db.Decimal
  discount_charge Decimal   @default(0) @db.Decimal
  platform_charge Decimal   @default(0) @db.Decimal
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  delivery_charge Decimal   @default(30) @db.Decimal
}

model contact_queries {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar
  email      String    @db.VarChar
  phone      String?   @db.VarChar
  subject    String?   @db.VarChar
  message    String
  status     String?   @default("Pending") @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  quantity   String?
}

model coupon_usage {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupon_id        String    @db.Uuid
  user_id          String    @db.Uuid
  order_id         String    @unique @db.Uuid
  discount_applied Decimal   @db.Decimal
  order_value      Decimal   @db.Decimal
  final_amount     Decimal   @db.Decimal
  idempotency_key  String    @unique @db.VarChar
  status           String?   @default("APPLIED") @db.VarChar
  reserved_at      DateTime? @db.Timestamptz(6)
  applied_at       DateTime? @default(now()) @db.Timestamptz(6)
  refunded_at      DateTime? @db.Timestamptz(6)
  cancelled_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  coupon           coupons   @relation(fields: [coupon_id], references: [id])
  order            orders    @relation(fields: [order_id], references: [id])
  user             users     @relation(fields: [user_id], references: [id])
}

model coupons {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String         @unique @db.VarChar
  discount_type        String         @db.VarChar
  discount_value       Decimal        @db.Decimal
  max_discount         Decimal?       @db.Decimal
  min_order_value      Decimal?       @default(0) @db.Decimal
  allowed_brands       Json?          @default("[]")
  new_user_only        Boolean?       @default(false)
  usage_limit_total    Int?
  usage_limit_per_user Int?           @default(1)
  valid_from           DateTime       @db.Timestamptz(6)
  valid_to             DateTime       @db.Timestamptz(6)
  timezone             String?        @default("UTC") @db.VarChar
  status               String?        @default("ACTIVE") @db.VarChar
  description          String?
  terms_conditions     String?
  created_by           String?        @db.Uuid
  created_at           DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?      @default(now()) @db.Timestamptz(6)
  usages               coupon_usage[]
}

model customer_testimonials {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar
  rating     Int       @default(5)
  image_url  String?
  comment    String
  active     Boolean?  @default(true)
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model daily_deals {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String?               @db.VarChar
  image_url  String?
  discount   String?               @db.VarChar
  badge      String?               @db.VarChar
  sort_order Int?                  @default(0)
  active     Boolean?              @default(true)
  banner_id  String?               @db.Uuid
  created_at DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at DateTime?             @default(now()) @db.Timestamptz(6)
  banner     add_banner?           @relation(fields: [banner_id], references: [id])
  products   daily_deals_product[]
}

model daily_deals_product {
  daily_deal_id String      @db.Uuid
  product_id    String      @db.Uuid
  daily_deal    daily_deals @relation(fields: [daily_deal_id], references: [id], onDelete: Cascade)
  product       products    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([daily_deal_id, product_id])
}

model delivery_charge_milestones {
  id              Int       @id @default(autoincrement())
  min_order_value Decimal   @unique @db.Decimal
  delivery_charge Decimal   @db.Decimal
  description     String?
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  discount        Decimal?  @default(0.00) @db.Decimal
  surcharge       Decimal?  @default(0.00) @db.Decimal
}

model delivery_zones {
  id              Int               @id @default(autoincrement())
  name            String            @unique @db.VarChar
  display_name    String?           @db.VarChar
  is_nationwide   Boolean?          @default(false)
  is_active       Boolean?          @default(true)
  description     String?
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  created_by      Int?
  warehouse_zones warehouse_zones[]
  zone_pincodes   zone_pincodes[]
}

model enquiries {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  name        String?
  email       String?
  phone       String?
  message     String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  status      String?   @default("pending") @db.VarChar
  admin_reply Boolean?  @default(false)
  admin_notes String?
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  type        String?   @default("regular") @db.VarChar
  subject     String?   @db.VarChar
  quantity    String?   @db.VarChar
  user        users?    @relation(fields: [user_id], references: [id])
}

model enquiry_bids {
  id             Int               @id @default(autoincrement())
  enquiry_id     Int
  bid_type       String?           @default("SINGLE_PRODUCT") @db.VarChar
  base_price     Decimal?          @db.Decimal
  quantity       Int?
  validity_hours Int?              @default(24)
  created_at     DateTime?         @default(now()) @db.Timestamp(6)
  expires_at     DateTime?         @db.Timestamp(6)
  status         String?           @default("ACTIVE") @db.VarChar
  created_by     String?           @db.Uuid
  terms          String?
  notes          String?
  enquiry        product_enquiries @relation(fields: [enquiry_id], references: [id])
}

model enquiry_messages {
  id              Int               @id @default(autoincrement())
  enquiry_id      Int
  sender_type     String            @db.VarChar
  sender_id       String            @db.Uuid
  sender_name     String?           @db.VarChar
  message         String
  is_read         Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  attachment_url  String?
  attachment_type String?           @db.VarChar
  enquiry         product_enquiries @relation(fields: [enquiry_id], references: [id])
}

model event_elevate {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar
  description   String?   @db.VarChar
  category      String?   @db.VarChar
  bg_color      String?   @default("from-purple-400 to-orange-400") @db.VarChar
  text_color    String?   @default("white") @db.VarChar
  badge_text    String?   @db.VarChar
  badge_color   String?   @default("bg-blue-600") @db.VarChar
  position      String?   @default("grid") @db.VarChar
  display_order Int?      @default(0)
  active        Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model faq_templates {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  faqs        Json
  category_id String?   @db.Uuid
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
}

model groups {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                   @db.VarChar
  description            String?
  icon                   String?                  @db.VarChar
  image_url              String?
  subcategory_id         String                   @db.Uuid
  featured               Boolean?                 @default(false)
  active                 Boolean?                 @default(true)
  sort_order             Int?                     @default(0)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  subcategory            subcategories            @relation(fields: [subcategory_id], references: [id])
  product_section_groups product_section_groups[]
  products               products[]
}

model inventory {
  id                   Int              @id @default(autoincrement())
  variant_id           String           @db.Uuid
  stock_qty            Int              @default(0)
  reserved_qty         Int              @default(0)
  bulk_stock_threshold Int?             @default(0)
  bulk_reserved_qty    Int?             @default(0)
  warehouse_id         Int
  updated_at           DateTime         @updatedAt @db.Timestamptz(6)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  mrp                  Decimal?         @db.Decimal
  offer_price          Decimal?         @db.Decimal
  status               InventoryStatus? @default(ACTIVE)
  seller_stock         Int              @default(0)
  admin_stock          Int              @default(0)
  variant              product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse            warehouses       @relation(fields: [warehouse_id], references: [id])

  @@unique([variant_id, warehouse_id])
  @@index([warehouse_id])
  @@index([stock_qty])
}

model order_execution_logs {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduled_order_id     String               @db.Uuid
  attempt_number         Int
  executed_at            DateTime?            @default(now()) @db.Timestamptz(6)
  status                 String               @db.VarChar
  inventory_check_passed Boolean?             @default(false)
  payment_check_passed   Boolean?             @default(false)
  error_message          String?
  error_code             String?              @db.VarChar
  execution_duration_ms  Int?
  worker_id              String?              @db.VarChar
  metadata               Json?                @default("{}")
  scheduled_order        scheduled_orders     @relation(fields: [scheduled_order_id], references: [id])
  payment_retry_logs     payment_retry_logs[]
}

model order_items {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String               @db.Uuid
  variant_id            String               @db.Uuid
  quantity              Int
  price                 Decimal              @db.Decimal
  is_bulk_order         Boolean?             @default(false)
  bulk_range            String?              @db.VarChar
  original_price        Decimal?             @db.Decimal
  assigned_warehouse_id Int?
  warehouse_name        String?              @db.VarChar
  warehouse             warehouses?          @relation(fields: [assigned_warehouse_id], references: [id])
  order                 orders               @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant               product_variants     @relation(fields: [variant_id], references: [id])
  return_order_items    return_order_items[]
  service_booking       service_bookings?

  @@index([order_id])
  @@index([variant_id])
}

model order_tracking {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String?   @db.Uuid
  status      String    @db.VarChar
  location    String?   @db.VarChar
  description String?
  timestamp   DateTime? @default(now()) @db.Timestamp(6)
  order       orders?   @relation(fields: [order_id], references: [id])
}

model orders {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?          @db.Uuid
  subtotal            Decimal          @db.Decimal
  shipping            Decimal          @db.Decimal
  total               Decimal          @db.Decimal
  address             String?
  payment_method      String?          @default("prepaid")
  status              String?          @default("Pending")
  created_at          DateTime?        @default(now()) @db.Timestamp(6)
  updated_at          DateTime?        @db.Timestamptz(6)
  razorpay_order_id   String?          @db.VarChar
  razorpay_payment_id String?          @db.VarChar
  tracking_number     String?          @db.VarChar
  estimated_delivery  DateTime?        @db.Timestamp(6)
  is_bulk_order       Boolean?         @default(false)
  company_name        String?          @db.VarChar
  gst_number          String?          @db.VarChar
  is_deleted          Boolean?         @default(false)
  handling_charge     Decimal?         @default(0) @db.Decimal
  surge_charge        Decimal?         @default(0) @db.Decimal
  platform_charge     Decimal?         @default(0) @db.Decimal
  coupon_code         String?          @db.VarChar
  coupon_discount     Decimal?         @default(0) @db.Decimal
  mobile              String?          @db.VarChar
  razorpay_signature  String?          @db.VarChar
  discount_charge     Decimal?         @default(0) @db.Decimal
  receiver_name       String?          @db.VarChar
  coupon_usage        coupon_usage?
  order_items         order_items[]
  tracking            order_tracking[]
  user                users?           @relation(fields: [user_id], references: [id])
  return_orders       return_orders[]
}

model partners {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar
  image_url  String
  active     Boolean?  @default(true)
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model payment_retry_logs {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduled_order_id String                @db.Uuid
  execution_log_id   String?               @db.Uuid
  retry_number       Int
  attempted_at       DateTime?             @default(now()) @db.Timestamptz(6)
  payment_method     String?               @db.VarChar
  amount             Decimal?              @db.Decimal
  status             String?               @db.VarChar
  error_code         String?               @db.VarChar
  error_message      String?
  next_retry_at      DateTime?             @db.Timestamptz(6)
  execution_log      order_execution_logs? @relation(fields: [execution_log_id], references: [id])
  scheduled_order    scheduled_orders      @relation(fields: [scheduled_order_id], references: [id])
}

model pincode_locations {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  pincode    String   @id @db.VarChar
  latitude   Float?
  longitude  Float?
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  String? @db.Uuid
  author    users?  @relation(fields: [authorId], references: [id])
}

model product_brand {
  product_id String   @db.Uuid
  brand_id   String   @db.Uuid
  brand      brand    @relation(fields: [brand_id], references: [id])
  product    products @relation(fields: [product_id], references: [id])

  @@id([product_id, brand_id])
}

model product_enquiries {
  id                Int                @id @default(autoincrement())
  user_id           String             @db.Uuid
  product_id        String             @db.Uuid
  variant_id        String?            @db.Uuid
  quantity          Int
  message           String?
  expected_price    Decimal?           @db.Decimal
  status            String?            @default("OPEN") @db.VarChar
  admin_notes       String?
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  updated_at        DateTime?          @default(now()) @db.Timestamp(6)
  expires_at        DateTime?          @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @db.Timestamp(6)
  closed_reason     String?            @db.VarChar
  closed_by         String?            @db.VarChar
  company_name      String?            @db.VarChar
  gst_number        String?            @db.VarChar
  phone             String?            @db.VarChar
  delivery_timeline String?            @db.VarChar
  bids              enquiry_bids[]
  messages          enquiry_messages[]
  product           products           @relation(fields: [product_id], references: [id])
}

model product_media {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String            @db.Uuid
  variant_id String?           @db.Uuid
  media_type MediaType
  url        String
  thumbnail  String?
  is_primary Boolean           @default(false)
  sort_order Int               @default(0)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  product    products          @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant    product_variants? @relation(fields: [variant_id], references: [id])

  @@index([product_id])
  @@index([variant_id])
}

model product_recommended_store {
  product_id           String            @db.Uuid
  recommended_store_id String            @db.Uuid
  product              products          @relation(fields: [product_id], references: [id])
  recommended_store    recommended_store @relation(fields: [recommended_store_id], references: [id])

  @@id([product_id, recommended_store_id])
}

model product_reviews {
  id                   Int       @id @default(autoincrement())
  product_id           String    @db.Uuid
  user_id              String?   @db.Uuid
  user_name            String    @db.VarChar
  user_email           String?   @db.VarChar
  rating               Int
  comment              String
  is_verified_purchase Boolean?  @default(false)
  helpful_count        Int?      @default(0)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  product              products  @relation(fields: [product_id], references: [id])
}

model product_section_categories {
  id               Int              @id @default(autoincrement())
  section_id       Int
  category_id      String           @db.Uuid
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  categories       categories       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  product_sections product_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, category_id])
}

model product_section_groups {
  id               Int              @id @default(autoincrement())
  section_id       Int
  group_id         String           @db.Uuid
  is_active        Boolean?         @default(true)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  groups           groups           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  product_sections product_sections @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, group_id])
}

model product_section_products {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String           @db.Uuid
  section_id    Int
  display_order Int?             @default(0)
  created_at    DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @default(now()) @db.Timestamptz(6)
  product       products         @relation(fields: [product_id], references: [id])
  section       product_sections @relation(fields: [section_id], references: [id])
}

model product_sections {
  id                         Int                            @id @default(autoincrement())
  section_key                String                         @unique @db.VarChar
  section_name               String                         @db.VarChar
  is_active                  Boolean?                       @default(true)
  display_order              Int?                           @default(0)
  component_name             String                         @db.VarChar
  description                String?
  created_at                 DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                      @default(now()) @db.Timestamp(6)
  allow_category_mapping     Boolean?                       @default(false)
  allow_group_mapping        Boolean?                       @default(false)
  is_marketing               Boolean?                       @default(false)
  product_section_categories product_section_categories[]
  product_section_groups     product_section_groups[]
  section_products           product_section_products[]
  subcategory_mappings       section_subcategory_mappings[]
  store_section_mappings     store_section_mappings[]
}

model product_variants {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id               String                    @db.Uuid
  sku                      String                    @unique @db.VarChar
  title                    String                    @db.VarChar
  price                    Decimal                   @db.Decimal
  old_price                Decimal?                  @db.Decimal
